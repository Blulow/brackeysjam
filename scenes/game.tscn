penalty_speeches = Array[String](["Hey! You just made a mistake, but luckily the guards handled it. Be careful next time.", "Once again! You let someone slip again! It caused some big trouble. We can’t handle any more mistakes, okay?", "Hey new guy, it’s nice seeing you. And this world… wasn’t really that beautiful anyway. I hope you saw the opposite though."])
ending_dialogue = Array[Array]([Array[String](["It is break time now, so take some rest, gotta get comfortable for this job, even when you can’t, haha.", "Well, let's meet back here in a few hours then, maybe grab some coffee now."]), Array[String](["And… Don't you think the world is so… beautiful? Despite everything that’s happening… Haha… hello? Are you there? Hello?? Hello???"])])

